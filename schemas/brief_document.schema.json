{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morningbrief.local/schemas/brief_document.schema.json",
  "title": "BriefDocument",
  "type": "object",
  "required": ["date", "generated_at", "status", "sections"],
  "additionalProperties": false,
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string" },
    "status": { "enum": ["ready", "degraded", "failed"] },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "body_md", "source_ids", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "type": "string" },
          "body_md": { "type": "string" },
          "source_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": { "enum": ["ok", "empty", "failed", "partial", "synthesized"] }
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "must_reads"],
      "properties": {
        "headline": { "type": "string" },
        "must_reads": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "section_id": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
